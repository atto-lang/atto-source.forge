cmake_minimum_required(VERSION 3.20)
foreach(required FORGE_COMPILER FORGE_CXX OUTPUT_ROOT)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "missing ${required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(driver "${OUTPUT_ROOT}/driver.cpp")
file(WRITE "${driver}" "#include <cstdio>\nextern \"C\" long long oresforge_entry(void);\nint main(){std::printf(\"%lld\\n\",oresforge_entry());}\n")
set(main "fnc main(): int { return 42; }")
foreach(case IN ITEMS leading trailing repeated)
  if(case STREQUAL leading)
    set(src "export pub main;\n${main}")
  elseif(case STREQUAL trailing)
    set(src "${main}\nexport pub fnc main;")
  else()
    set(src "export pub fnc main;\n${main}\nexport pub main;")
  endif()
  set(input "${OUTPUT_ROOT}/${case}.atto")
  set(asm "${OUTPUT_ROOT}/${case}.s")
  set(exe "${OUTPUT_ROOT}/${case}")
  file(WRITE "${input}" "${src}\n")
  file(REMOVE "${asm}" "${exe}")
  execute_process(COMMAND "${FORGE_COMPILER}" emit-asm x86_64 "${input}" RESULT_VARIABLE status OUTPUT_FILE "${asm}" ERROR_VARIABLE err TIMEOUT 15)
  if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
    message(FATAL_ERROR "export ${case}: ${err}")
  endif()
  execute_process(COMMAND "${FORGE_CXX}" -x assembler "${asm}" -x c++ "${driver}" -o "${exe}" RESULT_VARIABLE status ERROR_VARIABLE err TIMEOUT 30)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "link ${case}: ${err}")
  endif()
  execute_process(COMMAND "${exe}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
  if(NOT status STREQUAL "0" OR NOT out STREQUAL "42\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "guest ${case}: ${status} ${out} ${err}")
  endif()
  message(STATUS "EXPORT_NATIVE_GUEST ${case}=42")
endforeach()
foreach(case IN ITEMS package wrong_kind unknown nested budget)
  if(case STREQUAL package)
    set(src "export pub main;\nexport pub[pkg] fnc main;\n${main}")
  elseif(case STREQUAL wrong_kind)
    set(src "export pub class main;\n${main}")
  elseif(case STREQUAL unknown)
    set(src "export pub missing;\n${main}")
  elseif(case STREQUAL nested)
    set(src "fnc main(): int { export pub main; return 42; }")
  else()
    string(REPEAT "export pub main;\n" 129 directives)
    set(src "${directives}${main}")
  endif()
  set(input "${OUTPUT_ROOT}/${case}.atto")
  file(WRITE "${input}" "${src}\n")
  execute_process(COMMAND "${FORGE_COMPILER}" emit-asm x86_64 "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
  if(NOT status STREQUAL "1" OR NOT out STREQUAL "" OR err STREQUAL "")
    message(FATAL_ERROR "invalid export ${case}: ${status} ${out} ${err}")
  endif()
  message(STATUS "EXPORT_REJECTED_NO_ASM ${case}")
endforeach()
