# Symbolic checked casts are carrier identities in this signed-i64 frontend.
# Exercise native compiler output, not only AST acceptance.
function(verify_cast_expr name expr want_rc want_out want_err)
  set(source "${OUT_DIR}/cast-${name}.atto")
  set(cpp "${OUT_DIR}/cast-${name}.cpp")
  set(binary "${OUT_DIR}/cast-${name}")
  file(WRITE "${source}" "${quantity_declarations}\npub fnc main() -> int { return ${expr}; }\n")
  execute_process(COMMAND "${FORGE}" "${source}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "cast-${name}: compiler rejected: ${err}")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -Wall -Wextra -Werror
    ${guest_flags} "-I${ROOT}/include" "${cpp}" -o "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "cast-${name}: native build failed: ${err}")
  endif()
  execute_process(COMMAND "${binary}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
  if(NOT "${rc}" STREQUAL "${want_rc}" OR NOT "${out}" STREQUAL "${want_out}" OR NOT "${err}" STREQUAL "${want_err}")
    message(FATAL_ERROR "cast-${name}: status=${rc} stdout=[${out}] stderr=[${err}]")
  endif()
  message(STATUS "CAST_NATIVE_PASS ${name}")
endfunction()
