# Immutable typed bindings, unused initializer ordering and independent read metadata.
function(verify_binding id body status stdout stderr)
  file(WRITE "${OUT_DIR}/binding-${id}.atto" "${quantity_declarations}\npub fnc main() -> int {${body}}")
  execute_process(COMMAND "${FORGE}" "${OUT_DIR}/binding-${id}.atto" -o "${OUT_DIR}/binding-${id}.cpp" RESULT_VARIABLE rc ERROR_VARIABLE err TIMEOUT 15)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "binding compile failed ${id}: ${err}")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -Wall -Wextra -Werror ${guest_flags} "-I${ROOT}/include" "${OUT_DIR}/binding-${id}.cpp" -o "${OUT_DIR}/binding-${id}" RESULT_VARIABLE rc ERROR_VARIABLE err TIMEOUT 30)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "binding link failed ${id}: ${err}")
  endif()
  execute_process(COMMAND "${OUT_DIR}/binding-${id}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
  if(NOT "${rc}" STREQUAL "${status}" OR NOT "${out}" STREQUAL "${stdout}" OR NOT "${err}" STREQUAL "${stderr}")
    message(FATAL_ERROR "binding outcome ${id}: ${rc} ${out} ${err}")
  endif()
  message(STATUS "BINDING_NATIVE_PASS ${id}")
endfunction()
