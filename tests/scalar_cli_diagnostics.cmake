# Execute the native Forge CLI and verify stable source-safe diagnostics.
if(NOT DEFINED FORGE OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "missing compiler/diagnostics destination")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
function(check_diag label source expected)
  set(input "${OUT_DIR}/diagnostic_${label}.atto")
  set(output "${OUT_DIR}/diagnostic_${label}.cpp")
  file(WRITE "${input}" "${source}")
  file(WRITE "${output}" "stale source")
  execute_process(COMMAND "${FORGE}" "${input}" -o "${output}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(READ "${output}" preserved_output)
if(NOT "${rc}" STREQUAL "2" OR
   NOT "${preserved_output}" STREQUAL "stale source" OR
   NOT "${out}" STREQUAL "")
    message(FATAL_ERROR "${label}: invalid source admitted or caller-owned output modified")
  endif()
  if(NOT "${err}" MATCHES "^${expected} byte=[0-9]+\n$")
    message(FATAL_ERROR "${label}: expected ${expected} with byte offset, got [${err}]")
  endif()
endfunction()
check_diag(lexical "fnc main(): int {return @;}" "E_PARSE_LEXICAL")
check_diag(syntax "fnc main(): int {return 1 + ;}" "E_PARSE_SYNTAX")
check_diag(infix_caret "fnc main(): int {return 6 ^ 3;}" "E_PARSE_SYNTAX")
check_diag(split_xor "fnc main(): int {return 6 ^ /* split */ ^ 3;}" "E_PARSE_SYNTAX")
check_diag(triple_caret "fnc main(): int {return 6 ^^^ 3;}" "E_PARSE_SYNTAX")
check_diag(inline_begin "fnc main(): int begin\n^ 42;\nend" "E_PARSE_SYNTAX")
check_diag(range "fnc main(): int {return 9223372036854775808;}" "E_PARSE_RANGE")
string(REPEAT "(" 40 left)
string(REPEAT ")" 40 right)
check_diag(depth "fnc main(): int {return ${left}1${right};}" "E_PARSE_DEPTH")
set(many "fnc main(): int {return 1")
foreach(i RANGE 1 70)
  string(APPEND many "+1")
endforeach()
string(APPEND many ";}")
check_diag(nodes "${many}" "E_PARSE_NODES")

# Integrated fail-closed diagnostic forms (#103), not guest runtime claims.
check_diag(ownership "fnc main(): int {return copy!x;}" "E_OWNERSHIP_BANG_UNSUPPORTED")
check_diag(io_write "fnc main(): int {return c << 42;}" "E_IO_DIRECTION_UNSUPPORTED")
check_diag(io_read "fnc main(): int {return c >> 42;}" "E_IO_DIRECTION_UNSUPPORTED")
check_diag(pipe "fnc main(): int {return pipe;}" "E_UNSUPPORTED_CONTINUOUS_PIPE")
check_diag(rpipe "fnc main(): int {return rpipe;}" "E_UNSUPPORTED_CONTINUOUS_PIPE")
check_diag(task_spawn "fnc main(): int {return task<int> {return 42;};}" "E_TASK_UNSUPPORTED")
check_diag(task_nonvoid_do "fnc main(): int {do sync task<int> {return 1;};return 42;}" "E_TASK_RETURN_TYPE")
check_diag(task_inferred_nonvoid_do "fnc main(): int {do sync task {return 1;};return 42;}" "E_TASK_RETURN_TYPE")
check_diag(task_bare_void "fnc main(): int {sync task {};return 42;}" "E_PARSE_SYNTAX")
string(REPEAT "/*" 129 too_many_opens)
string(REPEAT "*/" 129 too_many_closes)
check_diag(nested_129 "fnc main(): int {return ${too_many_opens} copy!hidden ${too_many_closes} 42;}" "E_PARSE_LEXICAL")
