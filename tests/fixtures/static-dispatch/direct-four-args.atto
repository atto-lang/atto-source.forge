// Four true SysV integer argument registers and multiple nested native calls.
fnc add(a:int,b:int):int{return a+b;}
fnc multiply(a:int,b:int):int{return a*b;}
fnc smaller(a:int,b:int):int{return if a<b then a else b;}
fnc combine(a:int,b:int,c:int,d:int):int{return add(multiply(a,b),smaller(c,d));}
fnc main():int{return combine(5,6,12,50);}
