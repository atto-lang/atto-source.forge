# Real .atto guest -> Forge compiler -> generated C++ -> native executable.
# No host-only reference matcher counts as a guest pass.
if(NOT DEFINED ROOT OR NOT DEFINED FORGE OR NOT DEFINED CXX OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "missing Forge guest inputs")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
set(sanitize_flags)
if(SANITIZERS)
  list(APPEND sanitize_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()
function(real_guest label expected_rc expected_out expected_err)
  set(source "${ROOT}/fixtures/list-pattern-guest/${label}.atto")
  set(cpp "${OUT_DIR}/${label}.cpp")
  set(binary "${OUT_DIR}/${label}")
  execute_process(COMMAND "${FORGE}" "${source}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0" OR NOT EXISTS "${cpp}")
    message(FATAL_ERROR "${label}: real native source compiler failed: ${err}")
  endif()
  file(READ "${cpp}" emitted)
  if(NOT emitted MATCHES "std::array<atto::forge::i64" OR
     NOT emitted MATCHES "values")
    message(FATAL_ERROR "${label}: no checked native List storage was emitted")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -Wall -Wextra -Werror -pedantic
    ${sanitize_flags} "-I${ROOT}/include" "${cpp}" -o "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${label}: generated native guest build failed: ${err}")
  endif()
  execute_process(COMMAND "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "${expected_rc}" OR
     NOT "${out}" STREQUAL "${expected_out}" OR
     NOT "${err}" STREQUAL "${expected_err}")
    message(FATAL_ERROR
      "${label}: runtime rc=${rc}, stdout=[${out}], stderr=[${err}], expected rc=${expected_rc}")
  endif()
endfunction()
real_guest(list-pattern-rest-60 0 "60\n" "")
real_guest(list-pattern-guard-once-0 0 "0\n" "")
real_guest(list-pattern-infix-30 0 "30\n" "")
real_guest(list-pattern-anchored-no-match-7 0 "7\n" "")
real_guest(list-pattern-full-width-1 0 "1\n" "")
real_guest(list-pattern-leftmost-3 0 "3\n" "")
real_guest(list-pattern-max-length-32 0 "32\n" "")
# Same checked-overflow behavior, different target ABI: Rust uses panic_code=1.
real_guest(list-pattern-overflow-panic 70 "" "E_OVERFLOW\n")
file(READ "${ROOT}/fixtures/list-pattern-guest/list-pattern-rest-60.atto" base)
function(reject label source error_name)
  set(input "${OUT_DIR}/reject-${label}.atto")
  set(cpp "${OUT_DIR}/reject-${label}.cpp")
  file(WRITE "${input}" "${source}")
  file(REMOVE "${cpp}")
  execute_process(COMMAND "${FORGE}" "${input}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(FIND "${err}" "${error_name}" found)
  if(NOT "${rc}" STREQUAL "2" OR EXISTS "${cpp}" OR
     NOT "${out}" STREQUAL "" OR NOT found EQUAL 0)
    message(FATAL_ERROR "${label}: wanted ${error_name} with no artifact, got ${rc}: ${err}")
  endif()
  # A distinct existing destination must remain byte-identical when
  # compiler admission fails, even if the same source failed at an
  # initially absent destination. A stale file is NOT a new artifact.
  set(existing "${OUT_DIR}/existing-${label}.cpp")
  file(WRITE "${existing}" "KEEP_USER_FILE_UNCHANGED")
  execute_process(COMMAND "${FORGE}" "${input}" -o "${existing}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(READ "${existing}" preserved)
  string(FIND "${err}" "${error_name}" found)
  if(NOT "${rc}" STREQUAL "2" OR NOT found EQUAL 0 OR
     NOT "${preserved}" STREQUAL "KEEP_USER_FILE_UNCHANGED")
    message(FATAL_ERROR "${label}: failed compiler clobbered existing user file")
  endif()
  execute_process(COMMAND "${FORGE}" --check "${input}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(FIND "${err}" "${error_name}" found)
  if(NOT "${rc}" STREQUAL "2" OR NOT found EQUAL 0)
    message(FATAL_ERROR "${label}: source --check accepted an invalid pattern")
  endif()
endfunction()
set(invalid "${base}")
string(REPLACE "is int as val b" "is int as val a" invalid "${invalid}")
reject(duplicate-binder "${invalid}" "E_PATTERN_BINDING")
set(invalid "${base}")
string(REPLACE "a + b + c" "a + missing + c" invalid "${invalid}")
reject(unbound-result "${invalid}" "E_PATTERN_BINDING")
set(invalid "${base}")
string(REPLACE "is int as val b" "is bool as val b" invalid "${invalid}")
reject(wrong-type "${invalid}" "E_UNSUPPORTED")
set(invalid "${base}")
string(REPLACE "List.of(10, 20, 30, 40, 50)" "List.of(10, 20,)" invalid "${invalid}")
reject(trailing-constructor-comma "${invalid}" "E_PATTERN_SOURCE")
set(invalid "${base}")
string(REPLACE "..., is int as val a" "...(3 of int), is int as val a" invalid "${invalid}")
reject(unlowered-counted "${invalid}" "E_UNSUPPORTED")
set(invalid "${base}")
string(REPLACE "..., is int as val a" "pattern.of<int>(\"...\"), is int as val a" invalid "${invalid}")
reject(unlowered-template "${invalid}" "E_UNSUPPORTED")
set(invalid "${base}")
string(REPLACE "..., is int as val a" "..., ..., is int as val a" invalid "${invalid}")
reject(adjacent-rest "${invalid}" "E_PATTERN_SOURCE")
set(invalid "${base}")
string(REPLACE "is int as val a" "is int as val return" invalid "${invalid}")
reject(reserved-name "${invalid}" "E_RESERVED")
set(invalid "${base}")
string(REPLACE "on _ -> 0" "on _ -> a" invalid "${invalid}")
reject(capture-escape "${invalid}" "E_PATTERN_BINDING")
set(invalid "${base}")
string(REPLACE "is int as val b, is int as val c"
  "is int as val b, ..., is int as val c" invalid "${invalid}")
reject(interior-rest "${invalid}" "E_UNSUPPORTED")
set(many "")
foreach(i RANGE 1 33)
  if(NOT "${many}" STREQUAL "")
    string(APPEND many ", ")
  endif()
  string(APPEND many "${i}")
endforeach()
set(invalid "${base}")
string(REPLACE "10, 20, 30, 40, 50" "${many}" invalid "${invalid}")
reject(list-budget "${invalid}" "E_PATTERN_BUDGET")
execute_process(COMMAND "${FORGE}" --check
  "${ROOT}/fixtures/list-pattern-guest/list-pattern-rest-60.atto"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT "${rc}" STREQUAL "0" OR NOT "${err}" STREQUAL "")
  message(FATAL_ERROR "valid List guest failed source --check")
endif()
message(STATUS "FORGE_LIST_PATTERN_REAL_GUEST_TARGETS=7+overflow; negatives=11")
