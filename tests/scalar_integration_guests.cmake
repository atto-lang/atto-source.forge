# Real .atto -> C++ -> native binary integration evidence (when executed).
# Do not mistake a successful CMake configure or host model for guest proof.
if(NOT DEFINED ROOT OR NOT DEFINED FORGE OR NOT DEFINED CXX OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "missing integration guest test inputs")
endif()
set(native_flags)
if(SANITIZERS)
  list(APPEND native_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
function(guest name source want_rc want_out want_err)
  set(input "${OUT_DIR}/${name}.atto")
  set(cpp "${OUT_DIR}/${name}.cpp")
  set(bin "${OUT_DIR}/${name}")
  file(WRITE "${input}" "${source}")
  execute_process(COMMAND "${FORGE}" "${input}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0" OR NOT EXISTS "${cpp}" OR NOT "${err}" STREQUAL "")
    message(FATAL_ERROR "${name}: compiler rejected valid guest: rc=[${rc}] stderr=[${err}]")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -Wall -Wextra -Werror -pedantic
    ${native_flags} "-I${ROOT}/include" "${cpp}" -o "${bin}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${name}: generated native C++ failed: [${err}]")
  endif()
  execute_process(COMMAND "${bin}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "${want_rc}" OR
     NOT "${out}" STREQUAL "${want_out}" OR
     NOT "${err}" STREQUAL "${want_err}")
    message(FATAL_ERROR "${name}: native execution rc=[${rc}] stdout=[${out}] stderr=[${err}]")
  endif()
endfunction()
function(deny name source expected)
  set(input "${OUT_DIR}/${name}.atto")
  set(cpp "${OUT_DIR}/${name}.cpp")
  file(WRITE "${input}" "${source}")
  file(REMOVE "${cpp}")
  execute_process(COMMAND "${FORGE}" "${input}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "2" OR EXISTS "${cpp}" OR NOT "${out}" STREQUAL "" OR
     NOT "${err}" MATCHES "^${expected} byte=[0-9]+\\n$")
    message(FATAL_ERROR "${name}: unsafe accept/reject rc=[${rc}] stdout=[${out}] stderr=[${err}]")
  endif()
endfunction()

guest(caret "fnc main(): int {^ 42;}" "0" "42\n" "")
guest(integer_xor "fnc main(): int {return 12 ^^ 10;}" "0" "6\n" "")
guest(ordered_seq "fnc main(): int {return seq(2,3,42);}" "0" "42\n" "")
guest(ordered_tuple "fnc main(): int {return (> 2,3,42);}" "0" "42\n" "")
guest(inline_expr "fnc main(): int {return sync task<int> {return 42;};}" "0" "42\n" "")
guest(inline_do "fnc main(): int {do sync task<void> {return;};return 42;}" "0" "42\n" "")
guest(local_pointer "fnc main(): int {let value: int = 42;val Pointer<int> p = rt ref value;val answer = rt deref p;rt unref p;return answer;}" "0" "42\n" "")
guest(begin_end "int <- main()\nbegin\n^ 42;\nend." "0" "42\n" "")
guest(seq_trap "fnc main(): int {return seq(1/0,42);}" "71" "" "E_DIVZERO\n")
guest(seq_overflow "fnc main(): int {return seq(9223372036854775807+1,42);}" "70" "" "E_OVERFLOW\n")
string(REPEAT "/*" 128 opened)
string(REPEAT "*/" 128 closed)
guest(deep_comment "fnc main(): int {return ${opened} copy!secret ${closed} 42;}" "0" "42\n" "")
deny(bad_nonvoid_do "fnc main(): int {do sync task<int> {return 1;};return 42;}" "E_TASK_RETURN_TYPE")
deny(bad_bare_void "fnc main(): int {sync task {};return 42;}" "E_PARSE_SYNTAX")
deny(bad_pipe "fnc main(): int {return pipe;}" "E_UNSUPPORTED_CONTINUOUS_PIPE")
deny(bad_io "fnc main(): int {return c << 42;}" "E_IO_DIRECTION_UNSUPPORTED")
deny(bad_ownership "fnc main(): int {return take!x;}" "E_OWNERSHIP_BANG_UNSUPPORTED")
string(REPEAT "/*" 129 over_opened)
string(REPEAT "*/" 129 over_closed)
deny(overdeep_comment "fnc main(): int {return ${over_opened} copy!secret ${over_closed} 42;}" "E_PARSE_LEXICAL")
# Caller-owned existing output survives rejected source without mutation.
set(input "${OUT_DIR}/preserve_output.atto")
set(output "${OUT_DIR}/preserve_output.cpp")
file(WRITE "${input}" "fnc main(): int {return 12 ^ 10;}")
file(WRITE "${output}" "caller-owned output")
execute_process(COMMAND "${FORGE}" "${input}" -o "${output}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${output}" existing)
if(NOT "${rc}" STREQUAL "2" OR NOT "${existing}" STREQUAL "caller-owned output" OR
   NOT "${err}" MATCHES "^E_PARSE_SYNTAX byte=[0-9]+\\n$")
  message(FATAL_ERROR "source rejection modified preexisting output")
endif()
