// expect-error: E_POINTER_PROFILE
define struct Point { int x; int y; } with { constructor(int x, int y) { self.x = x; self.y = y; } } pub fnc main(): int { let Storage<Point> s = alloc! Point; let mut RawPointer<Point> p = RawPointer.empty<Point>(); new Point(40, 2) at s; new Point(1, 2) at s; destroy! s; free! s; return p; }
