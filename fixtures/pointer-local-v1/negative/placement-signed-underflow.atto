// expect-error: E_POINTER_PROFILE
define struct Point { int x; int y; } with { constructor(int x, int y) { self.x = x; self.y = y; } } pub fnc main(): int { let Storage<Point> s = alloc! Point; let mut RawPointer<Point> p = RawPointer.empty<Point>(); new Point(-9223372036854775808, 1) at s; ref! p to s; val first = (deref! p).x; unref! p; destroy! s; new Point(99, -1) at s; ref! p to s; val second = (deref! p).y; unref! p; destroy! s; free! s; return first + second; }
