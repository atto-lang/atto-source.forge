# Preserve the current scalar build. This separate profile uses compiler
# checked-overflow builtins; it is not general nominal or actor lowering.
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  add_library(atto_forge_nominal_scalar STATIC compiler/nominal_scalar.cpp)
  target_include_directories(atto_forge_nominal_scalar PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
  target_compile_features(atto_forge_nominal_scalar PUBLIC cxx_std_20)
  add_executable(forge_nominal tools/forge_nominal.cpp)
  target_link_libraries(forge_nominal PRIVATE atto_forge_nominal_scalar)
  if(BUILD_TESTING)
    add_executable(oresforge_nominal_class_tests verification/nominal_scalar_class_test.cpp)
    target_link_libraries(oresforge_nominal_class_tests PRIVATE atto_forge_nominal_scalar)
    add_test(NAME oresforge_nominal_scalar_class_contract COMMAND oresforge_nominal_class_tests)
    set_tests_properties(oresforge_nominal_scalar_class_contract PROPERTIES TIMEOUT 15)
  endif()
  set(_nominal_targets atto_forge_nominal_scalar forge_nominal)
  if(BUILD_TESTING)
    list(APPEND _nominal_targets oresforge_nominal_class_tests)
  endif()
  foreach(_target IN LISTS _nominal_targets)
    target_compile_options(${_target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
    if(ATTO_FORGE_SANITIZERS)
      target_compile_options(${_target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
      target_link_options(${_target} PRIVATE -fsanitize=address,undefined)
    endif()
  endforeach()
  if(BUILD_TESTING AND UNIX)
    add_test(NAME oresforge_nominal_scalar_cli_admission
      COMMAND /bin/sh "${CMAKE_CURRENT_SOURCE_DIR}/verification/nominal_scalar_cli_admission.sh"
              "$<TARGET_FILE:forge_nominal>")
    set_tests_properties(oresforge_nominal_scalar_cli_admission PROPERTIES TIMEOUT 15)
  endif()
  if(BUILD_TESTING AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND
     CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    find_program(ORESFORGE_NOMINAL_CLANG NAMES clang)
    if(ORESFORGE_NOMINAL_CLANG)
      add_test(NAME oresforge_nominal_scalar_class_native_x86_64
        COMMAND /bin/sh "${CMAKE_CURRENT_SOURCE_DIR}/verification/nominal_scalar_native_executable.sh"
                "$<TARGET_FILE:forge_nominal>" "${ORESFORGE_NOMINAL_CLANG}")
      set_tests_properties(oresforge_nominal_scalar_class_native_x86_64 PROPERTIES TIMEOUT 30)
    else()
      message(STATUS "Nominal native guest test NOT_EXECUTED: clang unavailable")
    endif()
  endif()
else()
  message(STATUS "Bounded Forge nominal profile unsupported for this C++ compiler")
endif()
